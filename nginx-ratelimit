STATES_PER_MB = 16000
ACCESS_LOG_SCAN_LINES = 50000

ERROR_LOG_TS = re.compile(r"^(\d{4}/\d{2}/\d{2} \d{2}:\d{2}:\d{2})")
LIMIT_LINE = re.compile(r"limiting requests.*zone \"([^\"]+)\"")
COMBINED_IP = re.compile(r"^(\S+)")


def tail_lines(path, limit):
    """Read up to `limit` trailing lines without loading the whole file."""
    try:
        size = os.path.getsize(path)
    except OSError as exc:
        raise IOError(str(exc))
    block = 65536
    data = b""
    with open(path, "rb") as handle:
        pos = size
        while pos > 0 and data.count(b"\n") <= limit:
            step = min(block, pos)
            pos -= step
            handle.seek(pos)
            data = handle.read(step) + data
    text = data.decode("utf-8", "replace")
    lines = text.splitlines()
    return lines[-limit:]


def zone_capacity():
    match = re.match(r"^(\d+)([km]?)$", ZONE_SIZE, re.I)
    if not match:
        return None
    value = int(match.group(1))
    unit = match.group(2).lower()
    megabytes = value if unit == "m" else (value / 1024.0 if unit == "k" else
                                           value / (1024.0 * 1024.0))
    return int(megabytes * STATES_PER_MB)


def check_proxy(dump_text, findings, dump_ok=True):
    has_real_ip_from = "set_real_ip_from" in (dump_text or "")
    has_real_ip_header = "real_ip_header" in (dump_text or "")
    logs_xff = "$http_x_forwarded_for" in (dump_text or "")
    logs_proxy_add = "$proxy_add_x_forwarded_for" in (dump_text or "")

    xff_seen = None
    if logs_xff:
        try:
            lines = tail_lines(ACCESS_LOG, 2000)
            xff_seen = False
            for line in lines:
                # combined-with-XFF puts it in a quoted field; a bare "-" means absent
                if re.search(r'"(?:\d{1,3}\.){3}\d{1,3}(?:, ?\S+)*"', line):
                    xff_seen = True
                    break
        except (IOError, OSError):
            xff_seen = None

    if not dump_ok:
        findings.append(("warn", "real_ip",
                         "Could not read the running configuration, so proxy "
                         "detection was skipped. Re-run as root. If nginx sits "
                         "behind Cloudflare or a load balancer without "
                         "set_real_ip_from/real_ip_header, $binary_remote_addr "
                         "is the proxy's address and every client behind it "
                         "shares one rate-limit bucket."))
        return

    if has_real_ip_from and has_real_ip_header:
        findings.append(("ok", "real_ip",
                         "set_real_ip_from and real_ip_header are configured; "
                         "$binary_remote_addr should be the true client."))
        return

    if xff_seen:
        findings.append(("fail", "real_ip",
                         "X-Forwarded-For is present in recent access log entries "
                         "but set_real_ip_from/real_ip_header are NOT configured. "
                         "$binary_remote_addr is the proxy's address, so every "
                         "client behind it shares one rate-limit bucket -- this "
                         "will rate-limit the entire internet as a single client."))
    elif logs_xff or logs_proxy_add:
        findings.append(("warn", "real_ip",
                         "The log format references X-Forwarded-For but no XFF "
                         "values were seen recently, and real_ip is not "
                         "configured. If traffic starts arriving via a proxy or "
                         "CDN, limiting will collapse onto one bucket."))
    else:
        findings.append(("warn", "real_ip",
                         "Cannot tell whether traffic arrives via a proxy: the "
                         "access log format does not capture X-Forwarded-For and "
                         "real_ip is not configured. If nginx sits behind "
                         "Cloudflare or a load balancer, configure "
                         "set_real_ip_from/real_ip_header before relying on "
                         "per-IP limits."))


def cmd_setup(args, out):
    """Add `include <conf.d>/*.conf;` to nginx.conf if nothing covers it.

    This is the one place the tool edits a file it did not generate, which is
    why it is an explicit subcommand rather than something `set` does on your
    behalf. Same discipline as every other write: back up, edit, `nginx -t`,
    restore on failure. nginx is never reloaded -- adding the include only
    matters once a level is set, and `set` reloads anyway.
    """
    require_nginx()
    conf_dir = os.path.dirname(CONF_PATH)
    include_line = "include %s/*.conf;" % conf_dir

    dump_code, dump_text = nginx_dump()
    if dump_code != 0:
        raise ToolError(
            "cannot read the running configuration (nginx -T exited %d); "
            "refusing to edit nginx.conf without knowing what it already "
            "contains." % dump_code,
            EXIT_NO_NGINX,
            {"nginx_T": (dump_text or "").strip()[-2000:]},
        )

    main_conf = main_config_path(dump_text)
    payload = {"action": "setup", "nginx_conf": main_conf,
               "include": include_line, "changed": False,
               "dry_run": bool(args.dry_run)}

    if config_was_read(dump_text) or include_covers(dump_text, CONF_PATH):
        out.say("%s is already included by the running configuration; "
                "nothing to do." % conf_dir)
        payload["reason"] = "already included"
        out.emit(payload)
        return EXIT_OK

    try:
        with open(main_conf, "r") as handle:
            original = handle.read()
    except (IOError, OSError) as exc:
        raise ToolError("cannot read %s: %s" % (main_conf, exc), EXIT_USAGE)

    point = find_http_insert_point(original)
    if point is None:
        raise ToolError(
            "could not find a top-level `http { ... }` block in %s. Add "
            "`%s` inside it by hand." % (main_conf, include_line),
            EXIT_USAGE,
        )

    candidate = (original[:point]
                 + "\n    # Added by nginx-ratelimit setup.\n    "
                 + include_line + "\n"
                 + original[point:])
    diff = "".join(difflib.unified_diff(
        original.splitlines(keepends=True),
        candidate.splitlines(keepends=True),
        fromfile=main_conf + " (current)",
        tofile=main_conf + " (candidate)",
    ))
    payload["diff"] = diff

    if args.dry_run:
        out.say(diff)
        out.say("Dry run: %s was not modified." % main_conf)
        out.emit(payload)
        return EXIT_OK

    require_root()
    ensure_dirs()
    try:
        os.makedirs(conf_dir, exist_ok=True)
    except OSError as exc:
        raise ToolError("cannot create %s: %s" % (conf_dir, exc), EXIT_USAGE)

    with Lock():
        stamp = utcnow().strftime("%Y%m%dT%H%M%SZ")
        backup = os.path.join(BACKUP_DIR, "nginx.conf.%s" % stamp)
        shutil.copy2(main_conf, backup)
        write_atomic(main_conf, candidate)

        code, output = nginx_test()
        if code != 0:
            shutil.copy2(backup, main_conf)
            recheck_code, recheck_output = nginx_test()
            raise ToolError(
                "adding the include made nginx -t fail; %s restored from %s."
                % (main_conf, backup),
                EXIT_VALIDATION,
                {"nginx_t": output.strip(),
                 "restore_verified": recheck_code == 0,
                 "restore_nginx_t": recheck_output.strip()},
            )

    payload["changed"] = True
    payload["backup"] = backup
    payload["nginx_t"] = output.strip()
    out.say(diff)
    out.say("Added the include to %s (backup: %s)." % (main_conf, backup))
    out.say("nginx -t passes. nginx was not reloaded; run "
            "`nginx-ratelimit set <level>` to apply a level.")
    out.emit(payload)
    return EXIT_OK


def cmd_check(args, out):
    findings = []
    details = {}

    if not nginx_available():
        raise ToolError("nginx not found on PATH (%s)." % NGINX_BIN, EXIT_NO_NGINX)
    findings.append(("ok", "installed", "nginx binary found."))

    running = nginx_running()
    findings.append(("ok" if running else "warn", "running",
                     "nginx master process is running." if running else
                     "No nginx master process found; level changes cannot reload."))

    code, version_output = run(nginx_cmd("-V"))
    details["nginx_version"] = version_output.strip().splitlines()[0] if version_output else ""
    if "--without-http_limit_req_module" in version_output:
        findings.append(("fail", "module",
                         "This nginx was built --without-http_limit_req_module; "
                         "limit_req is unavailable."))
    else:
        findings.append(("ok", "module",
                         "limit_req module is available (not excluded at build time)."))

    dump_code, dump_text = nginx_dump()
    if dump_code != 0:
        findings.append(("warn", "conf.d",
                         "Could not dump the running configuration (nginx -T "
                         "exited %d); skipping include and proxy checks." % dump_code))
        dump_text = ""
        dump_ok = False
    else:
        dump_ok = True
        marker = "# configuration file %s" % CONF_PATH
        if marker in dump_text:
            findings.append(("ok", "conf.d",
                             "%s is included by the running configuration." % CONF_PATH))
        elif os.path.isfile(CONF_PATH):
            findings.append(("fail", "conf.d",
                             "%s exists but is NOT included by the running "
                             "configuration. Check for `include "
                             "/etc/nginx/conf.d/*.conf;` inside the http block."
                             % CONF_PATH))
        else:
            findings.append(("warn", "conf.d",
                             "%s does not exist yet; nothing is being managed."
                             % CONF_PATH))

    check_proxy(dump_text, findings, dump_ok)

    capacity = zone_capacity()
    details["zone_capacity"] = capacity
    unique = None
    try:
        lines = tail_lines(ACCESS_LOG, ACCESS_LOG_SCAN_LINES)
        addrs = set()
        for line in lines:
            match = COMBINED_IP.match(line)
            if match and match.group(1) not in ("-", ""):
                addrs.add(match.group(1))
        unique = len(addrs)
        details["unique_clients_sampled"] = unique
        details["access_log_lines_sampled"] = len(lines)
    except (IOError, OSError) as exc:
        findings.append(("warn", "zone",
                         "Cannot read %s (%s); skipping zone headroom estimate."
                         % (ACCESS_LOG, exc)))

    if unique is not None and capacity:
        ratio = unique / float(capacity)
        message = ("zone %s:%s holds roughly %d client states; %d unique clients "
                   "in the last %d log lines (%.1f%% of capacity)."
                   % (ZONE_NAME, ZONE_SIZE, capacity, unique,
                      details.get("access_log_lines_sampled", 0), ratio * 100))
        if ratio >= 0.8:
            findings.append(("fail", "zone", message +
                             " At capacity nginx evicts the least recently used "
                             "states, so limits become unreliable."))
        elif ratio >= 0.5:
            findings.append(("warn", "zone", message + " Consider a larger zone -- "
                             "but note that changing the size resets every "
                             "client's state on reload."))
        else:
            findings.append(("ok", "zone", message))

    # 429s in the last hour, from the error log rather than the access log:
    # limit_req logs a "limiting requests" line at the configured level.
    rejected = 0
    delayed = 0
    try:
        cutoff = datetime.datetime.now() - datetime.timedelta(hours=1)
        for line in tail_lines(ERROR_LOG, ACCESS_LOG_SCAN_LINES):
            match = LIMIT_LINE.search(line)
            if not match or match.group(1) != ZONE_NAME:
                continue
            stamp = ERROR_LOG_TS.match(line)
            if stamp:
                try:
                    when = datetime.datetime.strptime(stamp.group(1), "%Y/%m/%d %H:%M:%S")
                except ValueError:
                    continue
                if when < cutoff:
                    continue
            if "delaying request" in line:
                delayed += 1
            else:
                rejected += 1
        details["rejected_last_hour"] = rejected
        details["delayed_last_hour"] = delayed
        findings.append(("ok", "429s",
                         "Last hour on zone %r: %d requests rejected (429), "
                         "%d delayed." % (ZONE_NAME, rejected, delayed)))
    except (IOError, OSError) as exc:
        findings.append(("warn", "429s",
                         "Cannot read %s (%s); skipping 429 counts."
                         % (ERROR_LOG, exc)))

    conflicts = conflicting_zone_declarations()
    if conflicts:
        findings.append(("fail", "zone-conflict",
                         "Zone %r is also declared in: %s. nginx refuses to "
                         "start on a duplicate zone name."
                         % (ZONE_NAME, ", ".join(conflicts))))

    labels = {"ok": "OK  ", "warn": "WARN", "fail": "FAIL"}
    for status, name, message in findings:
        out.say("[%s] %-13s %s" % (labels[status], name, message))

    worst = EXIT_OK
    if any(f[0] == "fail" for f in findings):
        worst = EXIT_VALIDATION
    out.emit({
        "findings": [{"status": s, "check": n, "message": m} for s, n, m in findings],
        "details": details,
        "ok": worst == EXIT_OK,
    })
    return worst


