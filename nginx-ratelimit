class Parser(argparse.ArgumentParser):
    """argparse exits 2 on a usage error; 2 is our "rolled back" code."""

    def error(self, message):
        self.print_usage(sys.stderr)
        self.exit(EXIT_USAGE, "%s: error: %s\n" % (self.prog, message))


def build_parser():
    parser = Parser(
        prog="nginx-ratelimit",
        description="Manage nginx rate limiting as a set of named levels.",
    )
    parser.add_argument("--dry-run", action="store_true",
                        help="print the unified diff and the nginx -t result; change nothing")
    parser.add_argument("--quiet", action="store_true", help="suppress human-readable output")
    parser.add_argument("--json", dest="json_mode", action="store_true",
                        help="machine-readable output")
    parser.add_argument("--force", action="store_true",
                        help="bypass the minimum reload interval")
    parser.add_argument("--reload-interval", type=float, default=DEFAULT_RELOAD_INTERVAL,
                        metavar="SECONDS",
                        help="minimum seconds between reloads (default: %(default)s)")

    sub = parser.add_subparsers(dest="command")

    sub.add_parser("status", help="current level, rate/burst, last change, reload count")
    p_set = sub.add_parser("set", help="jump directly to a level")
    p_set.add_argument("level", choices=LEVEL_NAMES, metavar="LEVEL")
    sub.add_parser("up", help="one level stricter")
    sub.add_parser("down", help="one level looser")
    sub.add_parser("off", help="alias for `set off`")
    sub.add_parser("levels", help="print the level table")
    p_allow = sub.add_parser("allow", help="add a CIDR to the whitelist")
    p_allow.add_argument("cidr")
    p_deny = sub.add_parser("deny", help="remove a CIDR from the whitelist")
    p_deny.add_argument("cidr")
    sub.add_parser("check", help="diagnostics")
    sub.add_parser("setup", help="add the conf.d include to nginx.conf if missing")
    return parser


COMMANDS = {
    "status": cmd_status,
    "set": cmd_set,
    "up": cmd_up,
    "down": cmd_down,
    "off": cmd_off,
    "levels": cmd_levels,
    "allow": cmd_allow,
    "deny": cmd_deny,
    "check": cmd_check,
    "setup": cmd_setup,
}


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    if not args.command:
        parser.print_help()
        return EXIT_USAGE

    out = Out(json_mode=args.json_mode, quiet=args.quiet)
    try:
        return COMMANDS[args.command](args, out)
    except ToolError as exc:
        if args.json_mode:
            payload = {"error": exc.message, "exit_code": exc.code}
            if exc.detail:
                payload["detail"] = exc.detail
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print("nginx-ratelimit: %s" % exc.message, file=sys.stderr)
            if exc.detail:
                for key, value in sorted(exc.detail.items()):
                    if value:
                        print("  %s: %s" % (key, value), file=sys.stderr)
        return exc.code
    except KeyboardInterrupt:
        print("interrupted", file=sys.stderr)
        return EXIT_USAGE


if __name__ == "__main__":
    sys.exit(main())
