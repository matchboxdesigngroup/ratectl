def cmd_levels(args, out):
    rows = []
    for lv in LEVELS:
        rows.append({
            "level": lv.name,
            "rate": lv.rate,
            "burst": lv.burst,
            "nodelay": lv.nodelay,
            "intent": lv.intent,
        })
    out.say("%-10s %-7s %-6s %-8s %s"
            % ("LEVEL", "RATE", "BURST", "NODELAY", "INTENT"))
    for lv in LEVELS:
        out.say("%-10s %-7s %-6s %-8s %s" % (
            lv.name,
            lv.rate or "-",
            lv.burst if lv.burst is not None else "-",
            ("yes" if lv.nodelay else "no") if lv.enforcing else "-",
            lv.intent,
        ))
    out.emit({"levels": rows, "order": LEVEL_NAMES})
    return EXIT_OK


def cmd_status(args, out):
    state = load_state()
    level = LEVEL_BY_NAME[state["level"]]
    conf_text = read_config_text()
    conf_level, conf_whitelist = parse_config(conf_text)
    drift = None
    if conf_text is None:
        drift = "config file %s is missing" % CONF_PATH
    elif conf_level != state["level"]:
        drift = ("state says %s but %s says %s"
                 % (state["level"], CONF_PATH, conf_level))

    payload = {
        "level": level.name,
        "rate": level.rate,
        "burst": level.burst,
        "nodelay": level.nodelay,
        "last_change": state["last_change"],
        "last_reload": state["last_reload"],
        "reload_count": state["reload_count"],
        "whitelist": state["whitelist"],
        "pinned": state["pinned"],
        "config_path": CONF_PATH,
        "config_present": conf_text is not None,
        "state_recovered": state["_recovered"],
        "drift": drift,
    }
    out.say("level:        %s" % level.name)
    if level.enforcing:
        out.say("rate/burst:   %s / %d%s"
                % (level.rate, level.burst, " nodelay" if level.nodelay else ""))
    else:
        out.say("rate/burst:   - (zone declared, not enforcing)")
    out.say("last change:  %s" % (state["last_change"] or "unknown"))
    out.say("last reload:  %s" % (state["last_reload"] or "unknown"))
    out.say("reloads:      %d" % state["reload_count"])
    out.say("whitelist:    %s" % (", ".join(state["whitelist"]) or "(empty)"))
    out.say("pinned:       %s" % ("yes" if state["pinned"] else "no"))
    if state["_recovered"]:
        out.say("note:         state cache was missing or corrupt; "
                "recovered from %s" % CONF_PATH)
    if drift:
        out.say("WARNING:      %s" % drift)
    out.emit(payload)
    return EXIT_OK


def cmd_set(args, out):
    name = args.level
    if name not in LEVEL_BY_NAME:
        raise ToolError(
            "unknown level %r. Known levels: %s" % (name, ", ".join(LEVEL_NAMES)),
            EXIT_USAGE,
        )
    state = load_state()
    return apply_change(args, out, LEVEL_BY_NAME[name], state["whitelist"], "set")


def _step(args, out, delta, action):
    state = load_state()
    index = LEVEL_NAMES.index(state["level"])
    target = index + delta
    if target < 0 or target >= len(LEVELS):
        edge = LEVELS[index]
        out.say("Already at %s (%s of the ordering); nothing to do."
                % (edge.name, "loosest" if delta < 0 else "strictest"))
        out.emit({"action": action, "level": edge.name, "changed": False,
                  "reason": "at end of ordering"})
        return EXIT_OK
    return apply_change(args, out, LEVELS[target], state["whitelist"], action)


def cmd_up(args, out):
    return _step(args, out, +1, "up")


def cmd_down(args, out):
    return _step(args, out, -1, "down")


def cmd_off(args, out):
    state = load_state()
    return apply_change(args, out, LEVEL_BY_NAME["off"], state["whitelist"], "off")


def cmd_allow(args, out):
    cidr = normalise_cidr(args.cidr)
    state = load_state()
    whitelist = sort_whitelist(list(state["whitelist"]) + [cidr])
    return apply_change(args, out, LEVEL_BY_NAME[state["level"]], whitelist, "allow")


def cmd_deny(args, out):
    cidr = normalise_cidr(args.cidr)
    state = load_state()
    if cidr not in state["whitelist"]:
        out.say("%s is not in the whitelist; nothing to do." % cidr)
        out.emit({"action": "deny", "cidr": cidr, "changed": False,
                  "whitelist": state["whitelist"], "reason": "not present"})
        return EXIT_OK
    whitelist = [c for c in state["whitelist"] if c != cidr]
    return apply_change(args, out, LEVEL_BY_NAME[state["level"]], whitelist, "deny")


